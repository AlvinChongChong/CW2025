<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.comp2042.MainMenuController"
           style="-fx-background-color: #1a1a2e;">
    <!-- Background -->
    <VBox alignment="CENTER" spacing="40" style="-fx-padding: 50;">
        <!-- Title -->
        <Label text="TETRIS" 
               style="-fx-text-fill: white; -fx-font-size: 72px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, #00ffff, 20, 0.5, 0, 0);" />
        
        <!-- Menu Buttons -->
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 20;">
            <Button fx:id="soloButton" text="Solo" 
                    onAction="#startSolo"
                    style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 15 40; -fx-min-width: 200;"
                    onMouseEntered="#onButtonHover" onMouseExited="#onButtonExit" />
            
            <Button fx:id="versusButton" text="Versus" 
                    onAction="#startVersus"
                    style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-background-color: #2196F3; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 15 40; -fx-min-width: 200;"
                    onMouseEntered="#onButtonHover" onMouseExited="#onButtonExit" />
            
            <Button fx:id="exitButton" text="Exit Game" 
                    onAction="#exitGame"
                    style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-background-color: #f44336; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 15 40; -fx-min-width: 200;"
                    onMouseEntered="#onButtonHover" onMouseExited="#onButtonExit" />
        </VBox>
    </VBox>
</StackPane>

